(module
  (import "env" "g" (global $ig i32))
  (import "env" "mg" (global $mg (mut i32)))
  (global $a (export "a") i32 (i32.const 42))
  (global $b (export "b") (mut i64) (i64.const -5))
  (global $c (export "c") (mut f32) (f32.const 1.5))
  (global $d (export "d") (mut f64) (f64.const 2.25))
  (global $e (export "e") i32 (global.get $ig))
  (global (export "v") (mut v128) (v128.const i32x4 1 2 3 4))
  (func (export "incb") global.get $b i64.const 1 i64.add global.set $b)
  (func (export "getmg") (result i32) global.get $mg)
  (func (export "setmg") (param i32) local.get 0 global.set $mg)
  (func (export "vsum") (result i32) global.get 7 i32x4.extract_lane 2 global.get 7 i32x4.extract_lane 3 i32.add)
  (func (export "vset") global.get 7 global.get 7 i32x4.add global.set 7)
)
