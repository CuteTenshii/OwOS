[Desktop Entry]
Type=Application
Name=Archive
GenericName=Archive Manager
Comment=Browse and extract ZIP and TAR archives
Exec=archive %f
Icon=utilities-file-archiver
Terminal=false
Categories=Utility;Archiving;
